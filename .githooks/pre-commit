#!/usr/bin/env bash
set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"
NPM_CACHE_DIR="$ROOT_DIR/.artifacts/npm-cache"
mkdir -p "$NPM_CACHE_DIR"

run_node_tests() {
  DIR="$1"
  if [ -f "$DIR/package.json" ]; then
    echo ""
    echo "Running Node tests in $DIR before commit (always)..."
    if [ -f "$DIR/package-lock.json" ]; then
      npm --cache "$NPM_CACHE_DIR" --prefix "$DIR" ci --workspaces=false >/dev/null
    else
      npm --cache "$NPM_CACHE_DIR" --prefix "$DIR" install >/dev/null
    fi

    if node -e "const p=require('./$DIR/package.json'); process.exit(p.scripts && p.scripts.test ? 0 : 1)"; then
      npm --cache "$NPM_CACHE_DIR" --prefix "$DIR" run test
    else
      echo "No test script in $DIR/package.json; skipping."
      return 0
    fi

    echo "Node tests passed in $DIR."
  else
    echo "No Node project in $DIR; skipping."
  fi
}

run_swift_tests() {
  TARGET_DIR="$1"
  if [ ! -f "$TARGET_DIR/Package.swift" ]; then
    echo "No Swift package in $TARGET_DIR; skipping."
    return 0
  fi

  if ! command -v swift >/dev/null 2>&1; then
    echo "swift not found in PATH. Cannot run mandatory iOS tests in $TARGET_DIR."
    echo "    Install Xcode (https://developer.apple.com/xcode/) then re-run ./scripts/setup-hooks.sh"
    return 1
  fi

  echo ""
  echo "Running Swift tests in $TARGET_DIR before commit (always)..."
  swift test --package-path "$TARGET_DIR"
  echo "Swift tests passed in $TARGET_DIR."
}

run_dotnet_tests() {
  if compgen -G "backend/*.sln" > /dev/null; then
    echo ""
    echo "Running .NET tests before commit (always)..."
    dotnet test backend/*.sln --verbosity minimal
    echo ".NET tests passed."
  else
    echo "No backend .NET solution; skipping."
  fi
}

# Run local commit guardrails
run_node_tests "agents"
run_node_tests "quant"
run_dotnet_tests
run_swift_tests "ios/KairosApp"

echo ""
echo "Pre-commit guardrails passed."
