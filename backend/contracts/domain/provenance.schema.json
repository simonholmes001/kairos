{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.local/contracts/domain/provenance.schema.json",
  "title": "Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceId", "sourceId", "sourceAuthority", "retrievedAt", "quality", "entitlement"],
  "properties": {
    "evidenceId": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "sourceAuthority": { "enum": ["primary", "provider", "derived", "operator", "simulation"] },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "sourceTime": { "type": "string", "format": "date-time" },
    "sourceUrl": { "type": "string" },
    "quality": { "enum": ["current", "delayed", "stale", "estimated", "alternative", "unverified", "missing"] },
    "qualityFlags": { "type": "array", "items": { "type": "string" } },
    "entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "tier", "cacheAllowed", "redistributionAllowed"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "minLength": 1 },
        "cacheAllowed": { "type": "boolean" },
        "redistributionAllowed": { "type": "boolean" }
      }
    }
  }
}
