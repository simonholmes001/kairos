{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.local/contracts/auth/operator-auth-boundary.schema.json",
  "title": "OperatorAuthBoundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["operatorId", "subject", "roles", "assuranceLevel", "permissions"],
  "properties": {
    "operatorId": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "array",
      "items": { "enum": ["operator", "approver", "viewer", "admin", "audit"] }
    },
    "assuranceLevel": { "enum": ["session", "biometric_reauth", "break_glass"] },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "portfolio.read",
          "decision.read",
          "proposal.approve",
          "proposal.reject",
          "risk.mode_change",
          "kill_switch.activate",
          "kill_switch.deactivate",
          "operator.manage",
          "risk.policy_manage",
          "audit.read"
        ]
      }
    }
  }
}
